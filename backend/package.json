{
  "name": "heraia-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "check": "tsc --noEmit",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts",
    "test": "node --import tsx --test src/api.test.ts",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "cors": "^2.8.5",
    "helmet": "^8.1.0",
    "express-rate-limit": "^7.5.0",
    "pg": "^8.16.0",
    "zod": "^3.25.0",
    "dotenv": "^16.5.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "tsx": "^4.19.0",
    "@types/express": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/jsonwebtoken": "^9.0.9"
  }
}
